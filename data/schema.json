{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resilix Demo Data",
  "type": "object",
  "required": [
    "companyName",
    "timestamp",
    "signals",
    "dependencyScore"
  ],
  "properties": {
    "companyName": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dependencyScore": {
      "type": "number"
    },
    "vMEME_distribution": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "roadmap": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
